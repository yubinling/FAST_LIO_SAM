<launch>
<!-- Launch file for Velodyne16 VLP-16 LiDAR -->

	<arg name="rviz" default="false" />

	<!-- 本地与 sat-slam 同时运行时，节点名不能和 fast_lio_sam 的 laserMapping 重复。 -->
	<node pkg="point_lio" type="pointlio_mapping" name="saulioMapping" output="screen">
	<rosparam command="load" file="$(find point_lio)/config/robosense_new.yaml" />
	<param name="use_imu_as_input" type="bool" value="1"/> <!--change to 1 to use IMU as input of Point-LIO-->
	<param name="prop_at_freq_of_imu" type="bool" value="1"/>
	<param name="check_satu" type="bool" value="1"/>
	<param name="init_map_size" type="int" value="10"/>
	<!-- 联合 sat-slam 时输入点云已经过预处理和动态剔除，这里尽量保留当前帧观测点。 -->
	<param name="point_filter_num" type="int" value="1"/> <!-- 原始 SAULIO 常用 4/3，联合模式先放宽到 1 -->
	<param name="space_down_sample" type="bool" value="1" />  
	<param name="filter_size_surf" type="double" value="0.2" /> <!-- 当前帧观测放宽，增加可匹配线/面特征 -->
	<param name="filter_size_map" type="double" value="0.5" /> <!--0.5, 0.3, 0.15, 0.1-->
	<param name="ivox_nearby_type" type="int" value="6" /> <!--0.5, 0.3, 0.15, 0.1-->
	<param name="runtime_pos_log_enable" type="bool" value="1" /> <!--1-->
	</node>
	<group if="$(arg rviz)">
	<!--<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find point_lio)/rviz_cfg/loam_livox.rviz" />-->
	<node  pkg="rviz" type="rviz" name="rviz" args="-d $(find point_lio)/rviz_cfg/loam_livox.rviz" />
	</group>

	launch-prefix="gdb -ex run --args"

</launch>
